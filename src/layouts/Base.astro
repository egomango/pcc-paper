---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/styles/global.css';
import { PAPER } from '~/config/paper';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const { title, description, ogImage = withBase('og.png') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const faviconHref = withBase('favicon.svg');
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: PAPER.title,
  description,
  author: {
    '@type': 'Person',
    name: PAPER.author.name,
    affiliation: PAPER.author.affiliations.map((name) => ({
      '@type': 'Organization',
      name,
    })),
    identifier: {
      '@type': 'PropertyValue',
      propertyID: 'ORCID',
      value: PAPER.author.orcid,
    },
  },
  datePublished: PAPER.datePublished,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'DOI',
    value: PAPER.doi,
  },
  sameAs: [PAPER.ssrnUrl, PAPER.doiUrl],
  url: canonical,
  image: ogImageUrl,
  keywords: PAPER.keywords.join(', '),
  license: PAPER.license.url,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    {import.meta.env.PROD && import.meta.env.PUBLIC_PLAUSIBLE_SRC && (
      <Fragment>
        <script async src={import.meta.env.PUBLIC_PLAUSIBLE_SRC}></script>
        <script is:inline>
          window.plausible = window.plausible || function() { (plausible.q = plausible.q || []).push(arguments) };
          plausible.init = plausible.init || function(i) { plausible.o = i || {} };
          plausible.init();
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
