---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const { title, description, ogImage = withBase('og.png') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const faviconHref = withBase('favicon.svg');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    {import.meta.env.PROD && (
      <script
        defer
        data-domain="egomango.github.io/pcc-paper"
        src="https://plausible.io/js/script.js"
      ></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
