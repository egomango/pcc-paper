---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import StickyCanvas from '~/components/StickyCanvas.astro';
import { PAPER } from '~/config/paper';

const sections = [
  { slug: '01-hero' },
  { slug: '02-regulator' },
  { slug: '03-switching-cost' },
  { slug: '04-windows' },
  { slug: '05-convergence' },
  { slug: '06-cta' },
];

const title = `${PAPER.shortTitle} — Why PMF happens`;
const description = `${PAPER.shortTitle} (${PAPER.acronym}): a cybernetic account of why product-market fit happens when it happens. Switching cost has two components, not one — and founders consistently under-price the one that actually kills deals.`;
---
<Base title={title} description={description}>
  <main class="layout">
    <div class="col-text">
      {sections.map((s, i) => <Section slug={s.slug} index={i} />)}
    </div>
    <StickyCanvas />
  </main>
  <footer class="page-footer">
    <ul class="footer-links">
      <li><a href={PAPER.ssrnUrl}>Read on SSRN</a></li>
      <li>DOI: <a href={PAPER.doiUrl}>{PAPER.doi}</a></li>
      <li>Licensed <a href={PAPER.license.url} rel="license">{PAPER.license.name}</a></li>
    </ul>
  </footer>
</Base>

<style>
  .page-footer {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 2rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--mid);
    font-size: 0.875rem;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .footer-links li { margin: 0; }
  .page-footer a { color: var(--mid); }
  .page-footer a:hover { color: var(--text); }
</style>
